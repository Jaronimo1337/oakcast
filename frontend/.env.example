# Public API (Vite prefix required for client)
# VITE_API_URL=http://localhost:5001/api

# When your social profiles are live, set full URLs (optional):
# VITE_SOCIAL_FACEBOOK_URL=https://www.facebook.com/yourpage
# VITE_SOCIAL_INSTAGRAM_URL=https://www.instagram.com/yourhandle
# If a profile is unavailable (e.g. review), hide the link until it works:
# VITE_SOCIAL_INSTAGRAM_URL=
# VITE_SOCIAL_YOUTUBE_URL=https://www.youtube.com/@yourchannel
