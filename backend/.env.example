PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=oakcast
DB_USER=postgres
DB_PASSWORD=postgres

# Hidden admin (/api/admin/login and upload/create projects)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_JWT_SECRET=use-a-long-random-string-at-least-32-chars

# Inquiry email delivery (SMTP)
# Leave empty to disable outgoing inquiry emails.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@oakcaststudio.com
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM=Oakcast Studio <info@oakcaststudio.com>
INQUIRY_TO=info@oakcaststudio.com
